{
  "style_id": "animated_social_captions",
  "name": "Animated Social Captions",
  "font_family": "Inter Display",
  "font_weight": 900,
  "font_color": "#FFFFFF",
  "text_alignment": "center",
  "letter_spacing_em": -0.05,
  "background": "transparent",
  "outline_enabled": true,
  "outline_color": "rgba(0,0,0,0.9)",
  "outline_width_px": 5,
  "shadow_enabled": true,
  "shadow_style": "0 8px 24px rgba(0,0,0,0.7)",
  "word_level_timing": true,
  "emphasis_enabled": true,
  "emphasis_scale": 1.6,
  "emphasis_color": "#22D3EE",
  "emphasis_font_weight": 900,
  "caption_grouping": {
    "minimum_words": 1,
    "maximum_words": 4,
    "target_words_per_cue": 2,
    "max_chars_per_line": 22,
    "pause_threshold_ms": 250
  },
  "animation": {
    "type": "kinetic_pop",
    "duration_ms": 130,
    "enter_frames": 3,
    "exit_frames": 2,
    "initial_scale": 0.92,
    "final_scale": 1.0,
    "exit_scale": 1.04,
    "fade_in": true,
    "fade_out": false,
    "easing": "easeOutBack"
  },
  "layout": {
    "horizontal_alignment": "center",
    "vertical_position": 0.52,
    "safe_margin_percent": 8,
    "max_width_percent": 90
  },
  "rendering": {
    "resolution_adaptive": true,
    "anti_aliasing": true,
    "transparent_overlay": true,
    "normal_size_pct_of_width": 0.075,
    "emphasis_size_pct_of_width": 0.115,
    "support_size_pct_of_width": 0.058
  }
}
